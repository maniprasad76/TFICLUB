# ──────────────────────────────────────
# TFI Project — Root .gitignore
# ──────────────────────────────────────

# Dependencies
node_modules/

# ⚠️  Environment files — NEVER commit any .env file
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
# Only the template file (no real secrets) is allowed
!.env.example

# Build outputs
dist/
backend/dist/
frontend/dist/
admin/dist/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright
**/playwright-report/
**/test-results/

# IDE / Agent temp files
.claude/
.codex/
.mcp.json
