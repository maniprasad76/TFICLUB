generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  phone           String?
  avatar          String?
  role            Role             @default(USER)
  authId          String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  addresses       Address[]
  cartItems       CartItem[]
  orders          Order[]
  reviews         Review[]
  wishlists       Wishlist[]
  loyaltyProgress LoyaltyProgress?

  @@index([role])
  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  description     String
  price           Decimal         @db.Decimal(10, 2)
  comparePrice    Decimal?        @db.Decimal(10, 2)
  images          String[]
  sizes           String[]
  colors          String[]
  categoryId      String
  stock           Int             @default(0)
  featured        Boolean         @default(false)
  bestseller      Boolean         @default(false)
  newArrival      Boolean         @default(false)
  rating          Float           @default(0)
  reviewCount     Int             @default(0)
  tags            String[]
  gender          Gender          @default(UNISEX)
  isActive        Boolean         @default(true)
  loyaltyEligible Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cartItems       CartItem[]
  orderItems      OrderItem[]
  category        Category        @relation(fields: [categoryId], references: [id])
  reviews         Review[]
  wishlists       Wishlist[]
  loyaltyRewards  LoyaltyReward[]

  @@index([categoryId])
  @@index([featured])
  @@index([bestseller])
  @@index([newArrival])
  @@index([isActive])
  @@index([gender])
  @@index([featured, isActive])
  @@index([createdAt])
  @@index([price])
  @@index([loyaltyEligible, isActive, price])
  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  size      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, color])
  @@index([userId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String  @id @default(uuid())
  orderNumber     String  @unique @default(uuid())
  idempotencyKey  String? @unique
  userId          String
  totalAmount     Decimal @db.Decimal(10, 2)
  shippingAmount  Decimal @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal @default(0) @db.Decimal(10, 2)
  couponCode      String?
  addressId       String?
  paymentMethod   String?
  paymentId       String?
  razorpayOrderId String?

  status               OrderStatus           @default(PENDING)
  trackingId           String?
  notes                String?
  expiresAt            DateTime?             @db.Timestamptz(6)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  items                OrderItem[]
  address              Address?              @relation(fields: [addressId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  payments             Payment[]
  loyaltyCountedOrders LoyaltyCountedOrder[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([razorpayOrderId])
  @@index([expiresAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  quantity  Int
  size      String?
  color     String?
  price     Decimal  @db.Decimal(10, 2)
  name      String
  image     String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id               String         @id @default(uuid())
  orderId          String
  gateway          PaymentGateway
  gatewayPaymentId String?
  gatewayOrderId   String?
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  status           PaymentStatus  @default(PENDING)
  method           String?
  idempotencyKey   String         @unique
  metadata         Json?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order          @relation(fields: [orderId], references: [id])
  refunds          Refund[]
  transactions     Transaction[]

  @@index([orderId])
  @@index([gatewayPaymentId])
  @@index([gatewayOrderId])
  @@index([status])
  @@map("payments")
}

model Transaction {
  id         String   @id @default(uuid())
  paymentId  String
  type       String
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("INR")
  status     String
  gatewayRef String?
  metadata   Json?
  createdAt  DateTime @default(now())
  payment    Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("transactions")
}

model Refund {
  id              String       @id @default(uuid())
  paymentId       String
  amount          Decimal      @db.Decimal(10, 2)
  reason          String?
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payment         Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([gatewayRefundId])
  @@map("refunds")
}

model WebhookLog {
  id        String   @id @default(uuid())
  gateway   String
  eventType String
  payload   Json
  signature String?
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@index([gateway, eventType])
  @@index([createdAt])
  @@index([signature])
  @@map("webhook_logs")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  photos    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentGateway {
  RAZORPAY

  COD
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String // e.g. "CREATE_PRODUCT", "UPDATE_PRODUCT", "DELETE_PRODUCT", "REFUND_PAYMENT", "UPDATE_SETTING"
  targetId   String? // ID of the modified entity
  targetType String? // e.g. "PRODUCT", "CATEGORY", "PAYMENT", "SETTING"
  ipAddress  String?
  userAgent  String?
  changes    Json? // stores old vs new value or description of changes
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String // "PERCENTAGE" | "FIXED"
  value         Decimal   @db.Decimal(10, 2)
  minCartAmount Decimal?  @db.Decimal(10, 2)
  maxDiscount   Decimal?  @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("coupons")
}

// ── Loyalty Club Rewards System ──

model LoyaltyProgress {
  id              String                @id @default(uuid())
  userId          String                @unique
  email           String
  currentCycle    Int                   @default(1)
  completedOrders Int                   @default(0)
  requiredOrders  Int                   @default(10)
  rewardUnlocked  Boolean               @default(false)
  rewardClaimed   Boolean               @default(false)
  lifetimeRewards Int                   @default(0)
  lastOrderId     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards         LoyaltyReward[]
  countedOrders   LoyaltyCountedOrder[]

  @@index([userId])
  @@map("loyalty_progress")
}

model LoyaltyReward {
  id                String          @id @default(uuid())
  loyaltyProgressId String
  cycle             Int
  productId         String?
  productName       String
  productImage      String?
  productSize       String?
  productColor      String?
  couponId          String?         @unique
  couponCode        String?
  claimedAt         DateTime        @default(now())
  loyaltyProgress   LoyaltyProgress @relation(fields: [loyaltyProgressId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([loyaltyProgressId])
  @@map("loyalty_rewards")
}

model LoyaltyCountedOrder {
  id                String          @id @default(uuid())
  loyaltyProgressId String
  orderId           String
  cycle             Int
  countedAt         DateTime        @default(now())
  loyaltyProgress   LoyaltyProgress @relation(fields: [loyaltyProgressId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [orderId], references: [id])

  @@unique([loyaltyProgressId, orderId])
  @@index([loyaltyProgressId])
  @@map("loyalty_counted_orders")
}
