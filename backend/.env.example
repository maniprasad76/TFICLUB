# ═══════════════════════════════════════════════════════════════
# FANCLUB Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV="development"  # 'development', 'production', or 'test'
PORT=3001

# ── Database (Supabase PostgreSQL) ─────────────────────────────
# Connection pooler URL (Transaction mode) for Prisma queries
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL for Prisma migrations
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ── CORS Origins ───────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# ── Razorpay Payment Gateway ──────────────────────────────────
# Leave empty for stub mode in development.
# In production (NODE_ENV=production), these are REQUIRED.
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET=""

# ── Cash on Delivery ──────────────────────────────────────────
COD_ENABLED=true

# ── Order Notifications (best-effort, never block the order flow) ──
# Optional email delivery for shipment notifications — POST { to, subject, body }
# with a Bearer token (Resend, Postmark, Brevo, or any HTTP email API).
# EMAIL_API_URL="https://api.resend.com/emails"
# EMAIL_API_TOKEN="your-token"

# ── Redis (optional — falls back to in-memory) ────────────────
# REDIS_URL="redis://localhost:6379"

# ── Admin Seeder (development only) ──────────────────────────
# Remove these once the admin account is created.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
